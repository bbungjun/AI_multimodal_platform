      "prefixes": ["qa/devtools/", "qa/executor/"],
      "reason": "qa_executor_requires_full_e2e"
    },
    {
      "id": "shared_runtime_changed",
      "effect": "all",
      "scenarios": [],
      "paths": [
        ".env.example",
        "docker-compose.yml",
        "docker-compose.vertex.yml",
        "backend/Dockerfile",
        "backend/app/main.py",
        "backend/app/config.py",
        "backend/app/db.py",
        "backend/app/api/__init__.py",
        "backend/app/models.py",
