    {
      "id": "documentation_only",
      "effect": "no_e2e",
      "scenarios": [],
      "paths": ["README.md", "AGENTS.md", "CONTEXT.md"],
      "prefixes": ["docs/"],
      "reason": "documentation_does_not_change_runtime"
    },
    {
      "id": "tests_only",
      "effect": "no_e2e",
      "scenarios": [],
      "paths": ["frontend/src/ui/viewModels.test-d.ts"],
      "prefixes": ["backend/tests/", "frontend/tests/"],
      "reason": "tests_do_not_change_runtime"
