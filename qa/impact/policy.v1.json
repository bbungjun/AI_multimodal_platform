    {
      "id": "operations_surface_changed",
      "effect": "scenario",
      "scenarios": ["role_ops_master"],
      "paths": [
        "frontend/src/pages/OpsPage.tsx",
        "frontend/src/pages/MasterPage.tsx",
        "frontend/src/api/ops.contract.ts",
        "frontend/src/ui/master.ts",
        "backend/app/api/ops.py",
        "backend/app/api/master.py",
        "backend/app/api/health.py",
        "backend/app/api/metrics.py"
