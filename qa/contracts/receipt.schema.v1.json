{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "creativeops://qa/receipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "revision", "registry_sha256", "provider", "source_unchanged", "scenario_results", "cleanup", "verdict"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{7,63}$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider": {"const": "mock"},
    "source_unchanged": {"type": "boolean"},
    "scenario_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "selected", "verdict", "assertions", "blocked_reasons"],
        "properties": {
          "scenario_id": {"type": "string"},
          "selected": {"type": "boolean"},
          "verdict": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_APPLICABLE"]},
          "assertions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "passed", "evidence"],
              "properties": {
                "id": {"type": "string"},
                "passed": {"type": "boolean"},
                "evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
              }
            }
          },
          "blocked_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"}}
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["browser", "mcp", "vite", "runtime"],
      "properties": {
        "browser": {"type": "integer", "minimum": 0},
        "mcp": {"type": "integer", "minimum": 0},
        "vite": {"type": "integer", "minimum": 0},
        "runtime": {"type": "integer", "minimum": 0}
      }
    },
    "verdict": {"enum": ["PASS", "FAIL", "BLOCKED"]}
  }
}
