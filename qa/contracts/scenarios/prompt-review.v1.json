{
  "schema_version": 1,
  "id": "prompt_review",
  "title_ko": "프롬프트 개선 초안 검토",
  "personas": ["free_user"],
  "goal": "개선 결과가 원문을 자동 덮어쓰지 않고 사용자의 편집·수락 선택만 생성 입력에 반영되는지 검증한다.",
  "related_paths": ["frontend/src/pages/GeneratePage.tsx", "backend/app/api/prompts.py", "backend/app/prompt_credit.py"],
  "setup": {"provider": "mock", "fixture": "reviewed_input_user", "destructive": false},
  "steps": [
    {"id": "enter_source", "intent": "원본 생성 입력을 작성한다.", "action": "type"},
    {"id": "request_draft", "intent": "개선 초안을 요청한다.", "action": "click"},
    {"id": "discard_draft", "intent": "초안을 버리고 원본이 유지되는지 확인한다.", "action": "click"},
    {"id": "edit_and_accept", "intent": "다시 받은 초안을 편집한 뒤 명시적으로 수락한다.", "action": "click"},
    {"id": "submit_generation", "intent": "검토가 끝난 입력으로 생성 요청을 보낸다.", "action": "click"}
  ],
  "assertions": [
    {"id": "review.request_created", "source": "network", "operator": "equals", "expected": 201, "evidence": ["network"]},
    {"id": "review.original_retained_before_accept", "source": "ui_snapshot", "operator": "equals", "expected": true, "evidence": ["ui_snapshot"]},
    {"id": "review.discard_restores_original", "source": "ui_snapshot", "operator": "equals", "expected": true, "evidence": ["ui_snapshot"]},
    {"id": "review.accept_applies_edited_draft", "source": "ui_snapshot", "operator": "equals", "expected": true, "evidence": ["ui_snapshot"]},
    {"id": "review.submission_matches_reviewed_input", "source": "database", "operator": "equals", "expected": true, "evidence": ["network", "database"]},
    {"id": "review.no_automatic_replacement", "source": "runtime_receipt", "operator": "equals", "expected": true, "evidence": ["runtime_receipt"]}
  ],
  "required_evidence": ["ui_snapshot", "network", "database", "runtime_receipt"],
  "exclusions": ["실제 Gemini 호출 품질 평가는 mock 계약 범위에서 제외"]
}
