{
  "schema_version": 1,
  "id": "t2v_generation",
  "title_ko": "Text-to-Video 생성과 무료 플랜 제한",
  "personas": ["free_user"],
  "goal": "영상 입력 검증, 무료 플랜 길이 제한, 작업 완료와 사용 가능한 영상 결과를 검증한다.",
  "related_paths": ["frontend/src/pages/GeneratePage.tsx", "backend/app/api/generations.py", "backend/app/generation_credit.py", "backend/app/services/jobs/runner.py"],
  "setup": {"provider": "mock", "fixture": "free_video_user", "destructive": false},
  "steps": [
    {"id": "observe_empty", "intent": "필수 입력이 비어 있을 때 제출 상태를 확인한다.", "action": "observe"},
    {"id": "request_long_video", "intent": "무료 플랜 제한을 넘는 영상 길이를 요청한다.", "action": "select"},
    {"id": "request_allowed_video", "intent": "허용 길이의 영상을 생성한다.", "action": "click"},
    {"id": "inspect_video", "intent": "완료 결과의 재생 또는 명시적 placeholder 안내를 확인한다.", "action": "observe"}
  ],
  "assertions": [
    {"id": "t2v.empty_submission_disabled", "source": "ui_snapshot", "operator": "disabled", "expected": true, "evidence": ["ui_snapshot"]},
    {"id": "t2v.free_duration_refused", "source": "network", "operator": "policy_refusal", "expected": true, "evidence": ["network"]},
    {"id": "t2v.refusal_has_zero_side_effects", "source": "database", "operator": "zero", "expected": true, "evidence": ["database"]},
    {"id": "t2v.allowed_job_completed", "source": "database", "operator": "state_transition", "expected": ["pending", "running", "completed"], "evidence": ["database", "runtime_receipt"]},
    {"id": "t2v.asset_mime", "source": "asset_probe", "operator": "equals", "expected": "video/mp4", "evidence": ["asset_probe"]},
    {"id": "t2v.outcome_is_usable", "source": "ui_snapshot", "operator": "equals", "expected": true, "evidence": ["ui_snapshot", "asset_probe"]}
  ],
  "required_evidence": ["ui_snapshot", "network", "database", "asset_probe", "runtime_receipt"],
  "exclusions": ["mock placeholder는 재생 가능하거나 placeholder임이 사용자에게 명확해야 함"]
}
