{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "creativeops://qa/scenario/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title_ko", "personas", "goal", "related_paths", "setup", "steps", "assertions", "required_evidence", "exclusions"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "title_ko": {"type": "string", "minLength": 1, "maxLength": 120},
    "personas": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "goal": {"type": "string", "minLength": 1, "maxLength": 300},
    "related_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "fixture", "destructive"],
      "properties": {
        "provider": {"type": "string"},
        "fixture": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
        "destructive": {"type": "boolean"}
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "intent", "action"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
          "intent": {"type": "string", "minLength": 1},
          "action": {"enum": ["navigate", "click", "type", "select", "reload", "observe", "fixture"]}
        }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "operator", "expected", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.]{2,95}$"},
          "source": {"type": "string"},
          "operator": {"type": "string"},
          "expected": {},
          "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "required_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "exclusions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  }
}
